# Copy this file to .env and fill in the values below.
# See SANITY_SETUP.md for the exact command sequence to get them.

# --- Client-side (exposed to the browser via import.meta.env) --------------
# Your Sanity project ID, from manage.sanity.io or the output of `sanity init`.
VITE_SANITY_PROJECT_ID=

# Dataset name. Defaults to "production" if unset.
VITE_SANITY_DATASET=production

# --- Server-side ONLY (never prefix with VITE_ — must never reach the browser) --
# A write-capable API token with Editor permissions, used by:
#   - api/submit-review.js (creates unapproved reviews from the public form)
#   - scripts/seed.mjs (seeds the dataset from src/data/products.js)
# Mint one at manage.sanity.io -> your project -> API -> Tokens -> Add API token.
SANITY_WRITE_TOKEN=

# --- Newsletter / Rs. 500 voucher signup (Brevo) ---------------------------
# Used by netlify/functions/subscribe.js, which backs both signup forms (the
# homepage voucher block and "The Letter" in the footer). Server-side only —
# a marketing API key in client JS can be used to read your whole contact list.

# Brevo -> SMTP & API -> API keys -> Generate a new API key.
BREVO_API_KEY=

# Numeric id of the contact list to add subscribers to.
# Brevo -> Contacts -> Lists — the id is in the URL of the list.
BREVO_LIST_ID=

# Double opt-in template id. STRONGLY recommended: Brevo emails a confirmation
# link and only adds the contact once they click it, so the Rs. 500 code only
# ever reaches an address someone actually controls. Put the voucher code in
# that template. Brevo -> Campaigns -> Templates (create a "Double opt-in"
# template; the id is in the URL).
# Leave blank for single opt-in — the contact is added immediately and NOTHING
# is emailed, so you would need a Brevo automation to send the voucher.
BREVO_DOI_TEMPLATE_ID=

# Where the confirmation link lands after the visitor clicks it. REQUIRED when
# BREVO_DOI_TEMPLATE_ID is set — Brevo rejects the call without it. Point it at
# the /welcome route, e.g. https://lyallpurwear.com/welcome
BREVO_DOI_REDIRECT_URL=

# --- The voucher itself ----------------------------------------------------
# Served by netlify/functions/voucher.js to confirmed list members only, so the
# code never ships in the browser bundle. All optional — the defaults below
# apply if unset. Change VOUCHER_CODE here rather than in the source.
VOUCHER_CODE=PEHLA500
VOUCHER_MIN_SPEND=3000
VOUCHER_AMOUNT=500

# Key for the encrypted token that carries a subscriber's address through the
# confirmation redirect, so /welcome resolves without them retyping it.
# Optional — falls back to BREVO_API_KEY if unset. Set it if you want to be
# able to rotate the Brevo key without invalidating every confirmation link
# already sitting in someone's inbox. Any long random string.
VOUCHER_TOKEN_SECRET=

# --- Contact form (Resend) -------------------------------------------------
# Used by netlify/functions/contact.js. Server-side only.

# resend.com -> API Keys.
RESEND_API_KEY=

# Where enquiries land. Comma-separate to copy in a second person.
# IMPORTANT: until a domain is verified at resend.com/domains, Resend will ONLY
# deliver to the address that owns the Resend account — anything else comes
# back 403 "You can only send testing emails to your own email address".
CONTACT_INBOX=

# Sender shown on the notification, e.g. "Lyallpur Wear <hello@lyallpurwear.com>".
# Requires a verified domain. Left blank it falls back to onboarding@resend.dev,
# which carries the same restriction described above.
CONTACT_FROM=

# Leads the subject line so you can tell which site a message came from when
# several properties share one inbox. Defaults to "Lyallpurwear".
#   Lyallpurwear · Contact form — Zawar Mian (order LW-2048)
CONTACT_SUBJECT_PREFIX=Lyallpurwear
