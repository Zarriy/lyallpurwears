# Copy this file to .env and fill in the values below.
# See SANITY_SETUP.md for the exact command sequence to get them.

# --- Client-side (exposed to the browser via import.meta.env) --------------
# Your Sanity project ID, from manage.sanity.io or the output of `sanity init`.
VITE_SANITY_PROJECT_ID=

# Dataset name. Defaults to "production" if unset.
VITE_SANITY_DATASET=production

# --- Server-side ONLY (never prefix with VITE_ — must never reach the browser) --
# A write-capable API token with Editor permissions, used by:
#   - api/submit-review.js (creates unapproved reviews from the public form)
#   - scripts/seed.mjs (seeds the dataset from src/data/products.js)
# Mint one at manage.sanity.io -> your project -> API -> Tokens -> Add API token.
SANITY_WRITE_TOKEN=
